# =====================================================================
#  HealRAG — Environment Configuration Template
#  Copy this file to `.env` and fill in your values.
#  NEVER commit the real `.env` (see .gitignore).
# =====================================================================

# ---- General application ----
APP_NAME=HealRAG
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---- Ollama (local LLM) ----
# Primary model for grading / evaluation / rewriting (fast & capable).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
# Alternative fast grading model (comment out the line above to use this).
# OLLAMA_CHAT_MODEL=phi4-mini
# Model used for final answer generation (can differ from grader).
OLLAMA_GENERATION_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Temperature for generation / grading (separate so you can tune).
GENERATION_TEMPERATURE=0.4
GRADER_TEMPERATURE=0.0
REWRITER_TEMPERATURE=0.2
# Request timeout (seconds) to Ollama.
OLLAMA_TIMEOUT=120

# ---- Embedding ----
# One of: ollama | sentence_transformers
EMBEDDING_BACKEND=ollama
EMBEDDING_DIMENSION=768
# Used only when EMBEDDING_BACKEND=sentence_transformers
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ---- Vector store (ChromaDB) ----
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=healrag_documents

# ---- Retrieval ----
RETRIEVAL_K=6              # number of vector chunks fetched
BM25_K=4                   # number of BM25 chunks fetched (fallback)
RELEVANCE_THRESHOLD=0.5    # grading threshold; below => rewrite + BM25
MAX_QUERY_REWRITES=2       # max rewrite cycles before force-generate
MAX_HALLUCINATION_RETRIES=2 # max re-generation passes in hallucination loop

# ---- Document ingestion ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_FILE_SIZE_MB=20

# ---- API / Web ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# A non-empty value enables simple bearer-token auth on the API.
API_BEARER_TOKEN=
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# ---- Streamlit UI ----
STREAMLIT_SERVER_PORT=3000
STREAMLIT_API_URL=http://localhost:8000

# ---- Observability ----
# Trace directory where every query graph-run is dumped as JSON.
TRACE_DIR=./traces
